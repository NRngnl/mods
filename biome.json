{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "my-files/**/*.js",
      "my-prs/**/*.js",
      "my-spaces/**/*.js",
      "my-prs-agents/**/*.js",
      "my-files/jsconfig.json",
      "biome.json",
      "!**/gpui-kit.d.ts",
      "!**/herdr.d.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "arrowParentheses": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
